# laidback-reviewer environment. Copy to .env and fill in.
# config.yaml names the variables; values never live in the config file.

# GitHub. Fine-grained PAT with exactly:
#   Pull requests: read and write    (posting reviews)
#   Contents: read-only              (clones, diffs; a push is impossible with this token)
#   Metadata: read-only, Issues: read-only, Checks: read-only, Commit statuses: read-only
# No Administration, no Secrets, no Dependabot. Set an expiry.
LAIDBACK_GH_TOKEN=github_pat_...

# Where the API is. Set it to a proxy or a test double only.
# LAIDBACK_GH_API=https://api.github.com

# Model. The key is read from the Pi agent dir's models.json, not from here, unless you override.
# STRATA_API_KEY=
# LAIDBACK_MODEL_PROVIDER=local/strata
# LAIDBACK_MODEL_ID=qwen3.8-flash-next-iq3_s

# Review agent definition: the directory on this host and the file name without .md. The directory is
# mounted into the container at the same absolute path, so agent.agentDir in config.yaml can be the same
# string in both places.
AGENT_DIR_HOST=/home/you/.pi/agent/agents
LAIDBACK_AGENT_NAME=pr-review
# Model provider definitions, mounted read-only instead of copied into the repository.
MODELS_JSON_HOST=/home/you/.pi/agent/models.json

# The skills the review standard is written in, and the cache they are symlinked into. Skills are
# symlinks, so the cache has to be mounted at the same absolute path or the mount dangles.
SKILLS_HOST=/home/you/.agents/skills
SKILLS_CACHE_HOST=/home/you/.cache/pi-agent-skills

# docker-compose.yml mounts config.yaml, data and work. The four host paths above are consumed by an
# untracked docker-compose.override.yml next to it, because they describe this machine rather than the
# bot. Compose merges the two files on its own; see README.

# Gate (gate.channel: slack in config.yaml).
# A user token pair, the same one slack-mcp-server uses. It can post and read, but Slack refuses a
# user-token conversations.open for your own DM, so pin a channel or IM id, or create the private
# channel named in config.yaml (gate.slack.channelName).
LAIDBACK_SLACK_CHANNEL=
LAIDBACK_SLACK_USERS=U_YOUR_USER_ID
SLACK_MCP_XOXC_TOKEN=xoxc-...
SLACK_MCP_XOXD_TOKEN=xoxd-...

# Check the whole round trip without a pull request: npm run gate:check
# (auth, channel discovery, a posted gate message, then your `approve <id>` reply)

# botToken transport (true DMs) instead of the user token:
# SLACK_MCP_XOXC_TOKEN=xoxb-...

# The container runs as this uid/gid, so state, artifacts and scratch keep the owner they have on the
# host. A login shell already exports UID and GID; pin them here when the loop starts from a service
# manager or cron, where no shell sets them.
UID=1000
GID=1000

# Paths inside the container, set by docker-compose; usually left alone.
LAIDBACK_STATE_DB=/data/state.db
LAIDBACK_ARTIFACT_DIR=/data/reviews
PI_CODING_AGENT_DIR=/app/.pi/agent
LAIDBACK_CONFIG=/app/config.yaml

# Telegram gate (gate.channel: telegram). Token from @BotFather; keep it in your password manager.
# Chat id and user id are both numeric; `npm run gate:check:telegram -- --discover` prints them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LAIDBACK_TELEGRAM_USERS=
