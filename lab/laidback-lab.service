# The lab daemon: one service, one unprivileged user, nothing of the bot's in its reach.
#
# Install it as the lab user's own unit, not root's: the runtime under it is rootless, so a container that
# escapes its namespaces owns an unprivileged account rather than the machine.

[Unit]
Description=Laidback reviewer lab daemon
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/laidback-reviewer/src/lab/daemon.mjs --port 9443 --host 172.17.0.1 --workspace /var/lib/laidback-lab --egress none --cpus 4 --memory 4096 --pids 512 --timeout-ms 600000 --concurrency 1
Environment=LAIDBACK_LAB_WORKSPACE=/var/lib/laidback-lab
Environment=LAIDBACK_LAB_EGRESS=none
Environment=LAIDBACK_LAB_PROXY=http://host.containers.internal:3128
# Readable by the bot and by the lab user, and by nobody else.
EnvironmentFile=/etc/laidback/lab.env
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/laidback-lab
MemoryMax=6G
TasksMax=512

[Install]
WantedBy=default.target
